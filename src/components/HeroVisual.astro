<script>
  class HeroVisual extends HTMLElement {
    private events?: AbortController;
    private frame = 0;

    connectedCallback() {
      this.events?.abort();
      this.events = new AbortController();
      const options = { signal: this.events.signal };
      const motion = window.matchMedia('(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)');
      let nextX = 0;
      let nextY = 0;

      const reset = () => {
        cancelAnimationFrame(this.frame);
        this.frame = 0;
        this.style.setProperty('--pointer-x', '0');
        this.style.setProperty('--pointer-y', '0');
      };

      this.addEventListener('pointermove', (event: PointerEvent) => {
        if (!motion.matches) return;
        const bounds = this.getBoundingClientRect();
        nextX = Math.max(-1, Math.min(1, (event.clientX - bounds.left) / bounds.width * 2 - 1));
        nextY = Math.max(-1, Math.min(1, (event.clientY - bounds.top) / bounds.height * 2 - 1));
        if (this.frame) return;
        this.frame = requestAnimationFrame(() => {
          this.style.setProperty('--pointer-x', nextX.toFixed(3));
          this.style.setProperty('--pointer-y', nextY.toFixed(3));
          this.frame = 0;
        });
      }, options);

      this.addEventListener('pointerleave', reset, options);
      motion.addEventListener('change', reset, options);
    }

    disconnectedCallback() {
      this.events?.abort();
      cancelAnimationFrame(this.frame);
    }
  }

  if (!customElements.get('hero-visual')) customElements.define('hero-visual', HeroVisual);
</script>

<style>
  .hero-visual {
    --pointer-x: 0;
    --pointer-y: 0;
    display: block;
    position: relative;
    isolation: isolate;
    width: 100%;
    max-width: 620px;
    aspect-ratio: 1.06;
    margin-inline: auto;
    perspective: 1000px;
  }

  .visual-atmosphere {
    position: absolute;
    inset: 7% -8% -3%;
    z-index: -2;
    background: radial-gradient(ellipse at 65% 53%, rgb(139 92 246 / 16%), transparent 65%);
    filter: blur(30px);
  }

  .visual-dot-field {
    position: absolute;
    inset: -4% -7%;
    z-index: -1;
    background-image: radial-gradient(circle, rgb(183 148 246 / 30%) 1px, transparent 1px);
    background-size: 19px 19px;
    mask-image: radial-gradient(ellipse, black 28%, transparent 73%);
  }

  .visual-orbit {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    color: rgb(183 148 246 / 21%);
    pointer-events: none;
  }

  .visual-plane {
    position: absolute;
    overflow: hidden;
    border: 1px solid rgb(220 204 255 / 14%);
    border-radius: 17px;
    background: linear-gradient(145deg, rgb(37 36 43 / 97%), rgb(20 19 26 / 97%));
    box-shadow: 0 25px 60px rgb(0 0 0 / 28%), inset 0 1px 0 rgb(255 255 255 / 3%);
    transform-style: preserve-3d;
    transition: transform 650ms cubic-bezier(.22, 1, .36, 1), border-color 350ms ease, box-shadow 350ms ease;
  }

  .design-plane {
    z-index: 2;
    top: 8%;
    left: 2%;
    width: 46%;
    transform: translate3d(calc(var(--pointer-x) * -8px), calc(var(--pointer-y) * -6px), 0) rotate(-7deg) rotateY(9deg);
  }

  .chart-plane {
    z-index: 1;
    top: 3%;
    right: -1%;
    width: 59%;
    transform: translate3d(calc(var(--pointer-x) * 8px), calc(var(--pointer-y) * 5px), 0) rotate(3deg) rotateY(-7deg);
  }

  .intelligence-plane {
    z-index: 3;
    bottom: 4%;
    left: 0;
    width: 58%;
    transform: translate3d(calc(var(--pointer-x) * -12px), calc(var(--pointer-y) * 8px), 0) rotate(-4deg) rotateY(5deg);
  }

  .screen-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    min-height: 37px;
    padding: 11px 15px;
    border-bottom: 1px solid rgb(255 255 255 / 5%);
    color: #a8a1b4;
    font-family: 'Montserrat', sans-serif;
    font-size: clamp(5px, .65vw, 8px);
    font-weight: 500;
    letter-spacing: .13em;
  }

  .window-dots, .signal-indicator { display: flex; gap: 4px; }
  .window-dots i { width: 4px; height: 4px; border-radius: 50%; background: rgb(255 255 255 / 18%); }
  .window-dots i:last-child { background: rgb(183 148 246 / 55%); }
  .toolbar-mark { font-size: 12px; color: #84778f; }
  .design-canvas { display: block; width: 100%; }
  .design-tile, .design-selection, .design-cursor { transition: transform 550ms cubic-bezier(.22, 1, .36, 1); }
  .design-selection { transform-origin: 150px 180px; }
  .signal-indicator { align-items: end; }
  .signal-indicator i { width: 2px; height: 4px; background: #9f7bcc; border-radius: 1px; }
  .signal-indicator i:nth-child(2) { height: 7px; }
  .signal-indicator i:nth-child(3) { height: 10px; }
  .chart-heading { padding: 20px 20px 0; display: flex; flex-direction: column; gap: 9px; }
  .chart-heading span:first-child { width: 41%; height: 7px; border-radius: 4px; background: rgb(230 220 246 / 20%); }
  .chart-heading span:last-child { width: 25%; height: 4px; border-radius: 2px; background: rgb(183 148 246 / 25%); }
  .signal-chart { display: block; width: calc(100% - 25px); margin: 10px auto 0; overflow: visible; }
  .chart-area { opacity: .62; transition: opacity 450ms ease; }
  .chart-line { stroke-dasharray: 1; stroke-dashoffset: 0; }
  .chart-point-halo { opacity: 0; transform-origin: 214px 64px; }
  .chart-widgets { display: grid; grid-template-columns: 1fr 1fr; gap: 9px; padding: 5px 15px 17px; }
  .chart-widgets > div { min-height: 70px; border: 1px solid rgb(255 255 255 / 6%); border-radius: 9px; background: rgb(255 255 255 / 1.5%); }
  .widget-ring { display: flex; align-items: center; gap: 4px; padding: 5px; }
  .widget-ring svg { width: 60%; }
  .ring-progress { transition: stroke-dasharray 700ms ease; }
  .widget-lines { display: flex; flex-direction: column; gap: 6px; flex: 1; padding-right: 6px; }
  .widget-lines span { height: 3px; border-radius: 2px; background: rgb(255 255 255 / 12%); }
  .widget-lines span:last-child { width: 70%; background: rgb(183 148 246 / 24%); }
  .widget-bars { padding: 6px; }
  .widget-bars svg { width: 100%; height: 100%; }
  .chart-bar { fill: #7654a7; transform-box: fill-box; transform-origin: bottom; transform: scaleY(.68); transition: transform 650ms cubic-bezier(.22, 1, .36, 1), fill 450ms ease; transition-delay: calc(var(--bar-order) * 45ms); }
  .intelligence-mark { color: #b794f6; font-size: 14px; }
  .neural-network { width: 100%; display: block; }
  .network-links { transition: stroke-opacity 400ms ease; }
  .network-nodes, .ai-core-glow { transition: opacity 400ms ease; }
  .network-signal { opacity: .15; }
  .ai-core-glow { opacity: .5; transform-origin: 162px 62px; }
  .ai-core-ring { transform-origin: 162px 62px; }
  .signal-track { position: relative; margin: 0 19px 18px; height: 1px; background: linear-gradient(90deg, transparent, rgb(183 148 246 / 32%), transparent); }
  .signal-sweep { position: absolute; inset: 0; background: linear-gradient(90deg, transparent, #bd9df0, transparent); opacity: .5; transform: scaleX(.3); transition: transform 500ms ease, opacity 500ms ease; }
  .signal-spark { position: absolute; top: -2px; left: 52%; width: 5px; height: 5px; background: #cbb2f5; border-radius: 50%; box-shadow: 0 0 9px 2px #a276de; transition: left 700ms cubic-bezier(.22, 1, .36, 1); }
  .technology-cube { position: absolute; bottom: 0; right: 7%; width: 16%; color: rgb(183 148 246 / 45%); transform: translate3d(calc(var(--pointer-x) * 12px), calc(var(--pointer-y) * -8px), 0) rotate(5deg); transition: transform 650ms cubic-bezier(.22, 1, .36, 1), color 350ms ease; }

  @media (hover: hover) and (pointer: fine) {
    .visual-plane:hover { border-color: rgb(183 148 246 / 40%); box-shadow: 0 28px 70px rgb(0 0 0 / 35%), 0 0 30px rgb(139 92 246 / 7%); }
    .design-plane:hover { transform: translate3d(calc(var(--pointer-x) * -8px), calc(var(--pointer-y) * -6px - 6px), 0) rotate(-5deg) rotateY(4deg); }
    .design-plane:hover .design-tile-a { transform: translateY(-3px); }
    .design-plane:hover .design-tile-b { transform: translateY(3px); }
    .design-plane:hover .design-selection { transform: scale(1.025); }
    .design-plane:hover .design-cursor { transform: translate(-14px, -8px); }
    .chart-plane:hover { transform: translate3d(calc(var(--pointer-x) * 8px), calc(var(--pointer-y) * 5px - 5px), 0) rotate(1deg) rotateY(-3deg); }
    .chart-plane:hover .chart-line { animation: trace-chart 850ms cubic-bezier(.22, 1, .36, 1) both; }
    .chart-plane:hover .chart-area { opacity: 1; }
    .chart-plane:hover .chart-point-halo { animation: chart-halo 1.1s ease-out 2; }
    .chart-plane:hover .chart-bar { transform: scaleY(1); fill: #a17be0; }
    .chart-plane:hover .ring-progress { stroke-dasharray: 111 132; }
    .intelligence-plane:hover { transform: translate3d(calc(var(--pointer-x) * -12px), calc(var(--pointer-y) * 8px - 6px), 0) rotate(-2deg) rotateY(2deg); }
    .intelligence-plane:hover .network-links { stroke-opacity: .45; }
    .intelligence-plane:hover .network-signal { opacity: .7; animation: neural-signal 2s linear infinite; }
    .intelligence-plane:hover .ai-core-glow { opacity: .9; }
    .intelligence-plane:hover .ai-core-ring { animation: core-pulse 1.4s ease-out 2; }
    .intelligence-plane:hover .signal-sweep { transform: scaleX(.9); opacity: .9; }
    .intelligence-plane:hover .signal-spark { left: 70%; }
    .hero-visual:hover .technology-cube { color: rgb(183 148 246 / 75%); transform: translate3d(calc(var(--pointer-x) * 12px), calc(var(--pointer-y) * -8px), 0) rotate(-4deg); }
  }

  @keyframes trace-chart { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @keyframes chart-halo { from { opacity: .6; transform: scale(.6); } to { opacity: 0; transform: scale(1.7); } }
  @keyframes neural-signal { to { stroke-dashoffset: -.48; } }
  @keyframes core-pulse { from { opacity: .65; transform: scale(.85); } to { opacity: 0; transform: scale(1.65); } }

  @media (max-width: 639px) {
    .hero-visual { max-width: 470px; }
    .screen-toolbar { min-height: 29px; padding: 8px 10px; font-size: 6px; letter-spacing: .08em; }
    .visual-plane { border-radius: 12px; }
    .chart-heading { padding: 13px 14px 0; gap: 6px; }
    .chart-heading span:first-child { height: 5px; }
    .chart-heading span:last-child { height: 3px; }
    .chart-widgets { padding: 3px 9px 11px; gap: 5px; }
    .chart-widgets > div { min-height: 46px; border-radius: 6px; }
    .signal-track { margin: 0 13px 13px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-visual * { animation: none !important; transition: none !important; }
    .design-plane, .design-plane:hover { transform: rotate(-7deg); }
    .chart-plane, .chart-plane:hover { transform: rotate(3deg); }
    .intelligence-plane, .intelligence-plane:hover { transform: rotate(-4deg); }
    .technology-cube, .hero-visual:hover .technology-cube { transform: rotate(5deg); }
    .design-tile, .design-selection, .design-cursor { transform: none !important; }
  }
</style>
